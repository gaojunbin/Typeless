{
  "name": "typeless-desktop",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Personal AI dictation for macOS and Windows",
  "author": "Typeless contributors",
  "license": "UNLICENSED",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/launch.mjs",
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "node tests/desktop.e2e.mjs",
    "test:delivery": "node tests/dictation-delivery.e2e.mjs",
    "verify:windows": "node scripts/verify-windows-helper.mjs",
    "package:mac": "node scripts/package.mjs mac",
    "package:win": "node scripts/package.mjs win",
    "package:win:installer": "node scripts/package.mjs installer",
    "preview": "vite --host 127.0.0.1"
  },
  "build": {
    "appId": "dev.typeless.desktop",
    "electronDownload": {
      "cache": ".cache/electron"
    },
    "productName": "Typeless",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": [
          "bin/**",
          "windows/**"
        ]
      }
    ],
    "mac": {
      "identity": "-",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Typeless records speech only when you start dictation.",
        "NSAppleEventsUsageDescription": "Typeless helps insert your dictation into your selected application."
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "zip"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
